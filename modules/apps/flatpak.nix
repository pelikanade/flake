{ inputs, ... }:
{
  flake-file.inputs.nix-flatpak.url = "github:gmodena/nix-flatpak/?ref=latest";

  flake.modules.nixos.flatpak = { pkgs, ... }: {
    services.flatpak.enable = true;

    xdg.portal = {
      enable = true;
      extraPortals = with pkgs; [
        xdg-desktop-portal-gtk
      ];
      config.common = {
        default = [ "gtk" ];
        "org.freedesktop.impl.portal.Secret" = [ "gnome-keyring" ];
      };
    };
  };

  flake.modules.homeManager.flatpak =
    {
      config,
      lib,
      osConfig,
      ...
    }:
    let
      /*
        Flatpak runs applications against the Freedesktop runtime's Fontconfig
        configuration. Host font files are bind-mounted into the sandbox, but
        the host's own Fontconfig configuration is not, so the generic-family
        aliases generated by NixOS and Stylix are missing. Chromium resolves a
        missing CJK glyph with a charset query carrying the document locale
        rather than `lang=zh-*`; without those aliases Maple Mono NF CN, which
        covers CJK and scores ahead of the runtime's Noto Sans CJK, becomes the
        fallback and every Chinese run renders monospaced. Mirror the host's
        default families inside the sandbox instead.
      */
      fontAlias = generic: families: ''
        <alias binding="same">
          <family>${generic}</family>
          <prefer>
        ${lib.concatMapStrings (family: ''
          <family>${lib.escapeXML family}</family>
        '') families}
          </prefer>
        </alias>
      '';
      fontDefaults = osConfig.fonts.fontconfig.defaultFonts;
      fontConfigDir = "${config.xdg.configHome}/flatpak-fontconfig";
      fontConfigFile = "${fontConfigDir}/fonts.conf";
    in
    {
      imports = [ inputs.nix-flatpak.homeManagerModules.nix-flatpak ];

      xdg.configFile."flatpak-fontconfig/fonts.conf".text = ''
        <?xml version="1.0"?>
        <!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
        <fontconfig>
          <!-- Runtime directories, caches and /app/etc/fonts/local.conf. -->
          <include ignore_missing="yes">/etc/fonts/conf.d</include>

        ${fontAlias "sans-serif" fontDefaults.sansSerif}
        ${fontAlias "serif" fontDefaults.serif}
        ${fontAlias "monospace" fontDefaults.monospace}
        ${fontAlias "emoji" fontDefaults.emoji}
        </fontconfig>
      '';

      services.flatpak = {
        enable = true;
        packages = [
          "com.slack.Slack"
          "io.github.kolunmi.Bazaar"
          "org.telegram.desktop"
          "org.localsend.localsend_app"
          "io.missioncenter.MissionCenter"
          "io.github.pwr_solaar.solaar"
          "com.qq.QQ"
          "com.tencent.WeChat"
          "com.tencent.wemeet"
        ];

        # Flatpak names the sandbox's timezone by matching TZDIR against the
        # target of /etc/localtime. nixpkgs gives PAM sessions
        # `TZDIR=/etc/zoneinfo`, which matches that target, but hands every
        # systemd unit `TZDIR=/nix/store/…-tzdata-…/share/zoneinfo` through
        # `systemd.globalEnvironment`; an application started from such a unit
        # — the bar's launcher is one — inherits a store path instead, the
        # match fails, and everything in its sandbox reads UTC while the host
        # stays on local time. Name the zone in the sandbox so the match is
        # not needed at all.
        overrides.settings.global = {
          Context.filesystems = [ "${fontConfigDir}:ro" ];
          Environment = {
            TZ = osConfig.time.timeZone;
            FONTCONFIG_FILE = fontConfigFile;
          };
        };
      };
    };
}
