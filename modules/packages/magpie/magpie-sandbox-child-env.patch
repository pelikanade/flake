From: Nix package maintenance
Subject: Wait for a child's environment in the sandbox

/proc/<pid>/environ is empty for a moment after exec here, so reading it
right after Start returns no variable at all. Both tests that read a
child's environment through proc.EnvOf asked before the kernel had it,
and failed with an empty map. They now wait for the variables they gave
the child; what they assert is unchanged.

---
 internal/proc/env_test.go                  | 17 ++++++++++++----
 internal/provider/codex_app_server_test.go | 13 +++++++++++++
 2 files changed, 26 insertions(+), 4 deletions(-)

diff --git a/internal/proc/env_test.go b/internal/proc/env_test.go
--- a/internal/proc/env_test.go
+++ b/internal/proc/env_test.go
@@ -65,10 +65,20 @@ func TestEnvOfChild(t *testing.T) {
 		t.Fatal(err)
 	}
 	t.Cleanup(func() { cancel(); _ = cmd.Wait() })
-	got, err := EnvOf(context.Background(), cmd.Process.Pid, "HOME", "CODEX_HOME", "LANG")
-	if err != nil {
-		t.Fatal(err)
-	}
+	// A child started in a sandbox can show an empty environment in
+	// /proc for a moment after Start; wait for the one it was given.
+	var got map[string]string
+	for deadline := time.Now().Add(2 * time.Second); ; {
+		var err error
+		got, err = EnvOf(context.Background(), cmd.Process.Pid, "HOME", "CODEX_HOME", "LANG")
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got["HOME"] != "" || time.Now().After(deadline) {
+			break
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
 	want := map[string]string{"HOME": "/sand box/h", "CODEX_HOME": "/sand box/h/.codex"}
 	if !reflect.DeepEqual(got, want) {
 		t.Fatalf("EnvOf = %v, want %v", got, want)
diff --git a/internal/provider/codex_app_server_test.go b/internal/provider/codex_app_server_test.go
--- a/internal/provider/codex_app_server_test.go
+++ b/internal/provider/codex_app_server_test.go
@@ -242,6 +242,17 @@ func TestCodexAppHomeHelper(t *testing.T) {
 	time.Sleep(30 * time.Second)
 }
 
+// waitCodexAppEnv waits for a fresh app-server's environment to show in
+// /proc, which a sandbox can report empty for a moment after Start.
+func waitCodexAppEnv(pid int) {
+	for deadline := time.Now().Add(2 * time.Second); time.Now().Before(deadline); time.Sleep(5 * time.Millisecond) {
+		env, err := proc.EnvOf(context.Background(), pid, "MAGPIE_CODEX_HOME_HELPER")
+		if err == nil && env["MAGPIE_CODEX_HOME_HELPER"] == "1" {
+			return
+		}
+	}
+}
+
 // Only the app-servers on magpie's Codex home are restarted: one under
 // another HOME or CODEX_HOME (a sandbox, another user) is left be.
 func TestCodexAppServersOnHome(t *testing.T) {
@@ -256,5 +267,6 @@ func TestCodexAppServersOnHome(t *testing.T) {
 			t.Fatal(err)
 		}
 		t.Cleanup(func() { cancel(); _ = cmd.Wait() })
+		waitCodexAppEnv(cmd.Process.Pid)
 		return cmd.Process.Pid
 	}
