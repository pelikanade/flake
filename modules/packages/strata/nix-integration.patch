+/// Helper directories a package build may add through `STRATA_HELPER_PATH`,
+/// separated by `:`. NixOS keeps system tools in the store instead of
+/// `/usr/bin` and `/usr/sbin`, and a package cannot install into the system
+/// profile, so a closure supplies the sandbox helper it was built against.
+/// The trust check is unchanged: a candidate still has to canonicalize under
+/// one of [`TRUST_ROOTS`], which covers `/nix/store`.
+fn package_helper_directories() -> Vec<PathBuf> {
+    option_env!("STRATA_HELPER_PATH")
+        .into_iter()
+        .flat_map(|value| std::env::split_paths(value).collect::<Vec<_>>())
+        .filter(|directory| directory.is_absolute())
+        .collect()
+}
+
 pub(crate) fn resolve(name: &str) -> Result<PathBuf, String> {
-    let search: Vec<&Path> = SEARCH_ROOTS.iter().copied().map(Path::new).collect();
+    // The fixed system directories stay first: a host's setuid wrapper must
+    // keep winning over the closure copy.
+    let mut directories: Vec<PathBuf> = SEARCH_ROOTS.iter().map(PathBuf::from).collect();
+    directories.extend(package_helper_directories());
+    let search: Vec<&Path> = directories.iter().map(PathBuf::as_path).collect();
     let trust: Vec<&Path> = TRUST_ROOTS.iter().copied().map(Path::new).collect();
     resolve_in(name, &search, &trust)
 }
