+#[test]
+fn nix_store_executables_defer_updates_to_nix() {
+    let dir = tempfile::tempdir().expect("create scratch dir");
+    // The store path decides before pacman is ever asked, because no package
+    // manager can replace a path under /nix/store.
+    let probe = ownership_probe(dir.path(), 0);
+
+    assert_eq!(
+        update_method_for(
+            Path::new("/nix/store/3n8lp0swxj93rpvfm9y3sgmnn0smpaqv-strata-1.0.0/bin/strata"),
+            &probe,
+            &dir.path().join("missing-os-release"),
+        ),
+        UpdateMethod::Nix
+    );
+}
+
+#[test]
+fn paths_that_merely_mention_the_store_keep_in_place_updates() {
+    let dir = tempfile::tempdir().expect("create scratch dir");
+    let probe = ownership_probe(dir.path(), 1);
+
+    assert_eq!(
+        update_method_for(
+            Path::new("/opt/nix/storehouse/bin/strata"),
+            &probe,
+            &dir.path().join("missing-os-release"),
+        ),
+        UpdateMethod::InPlace
+    );
+}
